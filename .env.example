# --- API keys (any you leave empty are skipped) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Which provider answers first; the next ones take over if it's busy
PROVIDER_ORDER=gemini,groq,openrouter

# --- Models (optional, these are the defaults) ---
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free

# --- Tuning (optional) ---
# PROVIDER_COOLDOWN_SECONDS=60
# TOP_K=5
# MIN_SCORE=0.35


# OCR (defaults shown)
# OCR_ENABLED=true
# OCR_MIN_CHARS=20
# OCR_MAX_PAGES=50
# OCR_DPI=200

# Step 7: hybrid search + reranker (defaults shown)
# HYBRID_SEARCH=true
# RERANK=true
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_MIN_SCORE=-7
# RERANK_GAP=8
# CANDIDATES=20
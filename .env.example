# --- API keys (any you leave empty are skipped) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
SAMBANOVA_API_KEY=
COHERE_API_KEY=

# Which provider answers first; the next ones take over if it's busy
PROVIDER_ORDER=gemini,groq,openrouter,mistral,cloudflare,sambanova,cohere

# --- Models (optional, these are the defaults) ---
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
MISTRAL_MODEL=mistral-small-latest
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
COHERE_MODEL=command-a-plus-05-2026

# --- Tuning (optional) ---
# PROVIDER_COOLDOWN_SECONDS=60
# TOP_K=5
# MIN_SCORE=0.35

# --- Web search (optional) ---
# DuckDuckGo works with no key. Add a free Tavily key (tavily.com) for better results;
# DuckDuckGo is then used only if Tavily fails.
TAVILY_API_KEY=
# Search automatically for questions about news, prices, "today", "latest"...
WEB_SEARCH_AUTO=true

# --- Image input (optional) ---
# Models used when a message has a picture. Gemini and OpenRouter's free router handle
# images with their normal model; Groq switches to its vision model.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b


# OCR (defaults shown)
# OCR_ENABLED=true
# OCR_MIN_CHARS=20
# OCR_MAX_PAGES=50
# OCR_DPI=200

# Step 7: hybrid search + reranker (defaults shown)
# HYBRID_SEARCH=true
# RERANK=true
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_MIN_SCORE=-7
# RERANK_GAP=8
# CANDIDATES=20


# Voice input (mic button) uses Groq Whisper with GROQ_API_KEY
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Voice language: keep ONE line active, put # in front of the others
STT_LANGUAGE=en
# STT_LANGUAGE=te
# STT_LANGUAGE=hi

# Login (step 11)
AUTH_ENABLED=true        # false = no login screen (local testing only)
ALLOW_SIGNUP=true        # set false after you create your account, so strangers can't sign up
COOKIE_SECURE=false      # set true once the app runs on https (step 12)
# SESSION_DAYS=30        # how long you stay logged in